+"""GLM literal tags: request-local prompt spans and generator stop hygiene."""
+import os
+import json
+import re
+import uuid
+
+TAGS = ('<think>', '</think>')
+LITERAL_TAG = re.compile(r'<[^<>\r\n]+>|\[(?:gMASK|sMASK|MASK)\]')
+
+
+def enabled(tool_format):
+    return tool_format == 'glm4_5' and os.getenv('TABBY_GLM_TOOL_FIXES') == '1'
+
+
+class PromptLiterals:
+    """Mask data before Jinja, then restore exact text and its literal-tag spans.
+
+    The random markers never reach the tokenizer, request model, or wire. Only
+    values supplied by messages/tools are masked; template control tags stay intact.
+    """
+    def __init__(self, values, excluded=()):
+        text = repr(values)
+        self.excluded = set(excluded)
+        while True:
+            self.prefix = '__TABBY_LITERAL_' + uuid.uuid4().hex + '_'
+            if self.prefix not in text:
+                break
+        tags = [t for t in dict.fromkeys(LITERAL_TAG.findall(text)) if t not in self.excluded]
+        self.markers = {self.prefix + str(i) + '__': tag for i, tag in enumerate(tags)}
+        self.pattern = re.compile('|'.join(map(re.escape, self.markers)) or r'(?!)')
+
+    def mask(self, value):
+        if isinstance(value, str):
+            for tag in LITERAL_TAG.findall(value):
+                if tag not in self.excluded and tag not in self.markers.values():
+                    self.markers[self.prefix + str(len(self.markers)) + '__'] = tag
+            self.pattern = re.compile('|'.join(map(re.escape, self.markers)) or r'(?!)')
+            for marker, tag in self.markers.items():
+                value = value.replace(tag, marker)
+            return value
+        if isinstance(value, list):
+            return [self.mask(v) for v in value]
+        if isinstance(value, dict):
+            return {self.mask(k): self.mask(v) for k, v in value.items()}
+        return value
+
+    def restore(self, prompt):
+        pieces, spans, cursor, size = [], [], 0, 0
+        for match in self.pattern.finditer(prompt):
+            head, tag = prompt[cursor:match.start()], self.markers[match[0]]
+            pieces.extend((head, tag))
+            size += len(head)
+            spans.append((size, size + len(tag)))
+            size += len(tag)
+            cursor = match.end()
+        pieces.append(prompt[cursor:])
+        return ''.join(pieces), tuple(spans)
+
+
+def encode_prompt(tokenizer, prompt, params, *, add_bos=False, embeddings=None):
+    record = getattr(params, '_glm_prompt_literals', None)
+    if not record or not prompt.startswith(record[0]):
+        return tokenizer.encode(prompt, add_bos=add_bos, encode_special_tokens=True,
+                                embeddings=embeddings or [])
+    # Appended continuation/injection text is structural; spans refer to the
+    # unchanged original prompt prefix. Never infer data spans from tag spelling.
+    spans = record[1]
+    if not spans:
+        return tokenizer.encode(prompt, add_bos=add_bos, encode_special_tokens=True,
+                                embeddings=embeddings or [])
+    parts, cursor = [], 0
+    for start, end in spans:
+        parts.append(tokenizer.encode(prompt[cursor:start], add_bos=add_bos if not parts else False,
+                                      encode_special_tokens=True, embeddings=_shift_embeddings(embeddings, parts)))
+        # Some GLM tags are added tokens marked special=False. ExLlama's flag
+        # cannot disable that matching. Subdivide only those exact data spans;
+        # no separators or rewritten spelling ever enter the prompt.
+        literal = _literal_pieces(tokenizer, prompt[start:end])
+        parts.extend(literal)
+        cursor = end
+    parts.append(tokenizer.encode(prompt[cursor:], add_bos=False,
+                                  encode_special_tokens=True, embeddings=_shift_embeddings(embeddings, parts)))
+    ids = [tid for part in parts for tid in part.flatten().tolist()]
+    # Keep the tokenizer's tensor dtype/device without importing GPU libraries.
+    if os.getenv('TABBY_GLM_TAG_TRACE') == '1':
+        from common.logger import xlogger
+        import hashlib
+        trace(xlogger, getattr(params, 'request_id', None), 'prompt_literals',
+              prompt_sha256=hashlib.sha256(prompt.encode()).hexdigest(),
+              literal_spans=len(spans), token_count=len(ids))
+    return parts[0].new_tensor([ids])
+
+
+class _ShiftEmbedding:
+    def __init__(self, embedding, offset):
+        self.embedding, self.offset = embedding, offset
+    def __getattr__(self, name):
+        return getattr(self.embedding, name)
+    def token_list_at(self, position):
+        return self.embedding.token_list_at(position + self.offset)
+
+
+def _shift_embeddings(embeddings, parts):
+    # Preserve global positions for aliases after a protected literal span.
+    offset = sum(part.shape[-1] for part in parts)
+    return [_ShiftEmbedding(e, offset) for e in (embeddings or [])]
+
+
+def _literal_pieces(tokenizer, text, control_ids=None):
+    encoded = tokenizer.encode(text, add_bos=False, encode_special_tokens=False, embeddings=[])
+    # Added tags may be flagged unspecial. Inspect exact IDs, not that flag.
+    if control_ids is None:
+        control_ids = {tokenizer.single_id(text)} - {None}
+    if not control_ids.intersection(encoded.flatten().tolist()):
+        return [encoded]
+    # GLM tag spellings have multiple characters. Neither half can match the
+    # whole added token; recurse in case a half itself is another added token.
+    midpoint = len(text) // 2
+    return (_literal_pieces(tokenizer, text[:midpoint], control_ids) +
+            _literal_pieces(tokenizer, text[midpoint:], control_ids))
+
+
+class ReasoningControls:
+    """Align emitted reasoning control IDs with the original engine text.
+
+    Keep IDs/text across chunks so a preceding multibyte character can finish
+    decoding before a tag. Never infer a control from its visible spelling.
+    """
+    def __init__(self, tokenizer):
+        self.tokenizer = tokenizer
+        self.tags = {tokenizer.single_id(t): t for t in TAGS}
+        self.tags.pop(None, None)
+        self.ids, self.text = [], ''
+        self.pending_controls = []
+
+    def feed(self, text, ids):
+        start = len(self.text)
+        self.text += text
+        offset = len(self.ids)
+        self.ids.extend(ids)
+        self.pending_controls.extend(offset + i for i, tid in enumerate(ids) if tid in self.tags)
+        if not self.pending_controls:
+            return [], False
+        controls, mismatch, pending = [], False, []
+        for i in self.pending_controls:
+            tag = self.tags[self.ids[i]]
+            prefix = self.tokenizer.decode_(self.ids[:i], True)
+            pos = len(prefix)
+            if pos < start:
+                mismatch = True
+                continue
+            if self.text[:pos] != prefix or self.text[pos:pos + len(tag)] != tag or pos + len(tag) > len(self.text):
+                mismatch = True
+                pending.append(i)
+                continue
+            controls.append((pos - start, pos - start + len(tag), tag))
+        self.pending_controls = pending
+        # Only discard state after a verified decoding boundary. A backend
+        # mismatch is logged for the operator; it never rejects user text.
+        if self.tokenizer.decode_(self.ids, True) == self.text:
+            self.ids, self.text = [], ''
+            self.pending_controls = []
+        else:
+            mismatch = True
+        return controls, mismatch
+
+
+def build_stops(tokenizer, request_stops, hf_eos, backend_eos, *, fixes_on):
+    request_stops = list(request_stops or [])
+    ids = {tokenizer.single_id(tag) for tag in TAGS} if fixes_on else set()
+    ids.discard(None)
+    vocab = tokenizer.get_id_to_piece_list(True) if fixes_on else []
+    combined = request_stops + list(hf_eos) + list(backend_eos)
+    # Also check the decoded piece for aliases/IDs absent from single_id().
+    def is_tag(value):
+        if isinstance(value, int):
+            return value in ids or (0 <= value < len(vocab) and vocab[value] in TAGS)
+        return value in TAGS
+    removed = [v for v in combined if fixes_on and is_tag(v)]
+    kept = [v for v in combined if not fixes_on or not is_tag(v)]
+    return list(dict.fromkeys(kept)), list(dict.fromkeys(removed))
+
+
+def trace(logger, request_id, event, **fields):
+    if os.getenv('TABBY_GLM_TAG_TRACE') == '1':
+        payload = {'event': event, 'request_id': request_id, **fields}
+        # XLogger's extra dict goes only to Seq. Put the bounded diagnostic
+        # fields in the message too so ordinary console/file logs are sufficient.
+        logger.info('[GLM-TAG-R4] ' + json.dumps(payload, ensure_ascii=False, default=str), payload)
