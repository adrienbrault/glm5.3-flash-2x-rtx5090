+def build_glm_grammar(forcing, tools, tool_start, tool_end, single_id, outer_ws=True,
+                      content_max_tokens=0):
+    """GLM XML grammar: constrain the function name and call count, not value schemas."""
+    names = [tool.function.name for tool in tools]
+    names = [name for name in names if _PARSEABLE_NAME.fullmatch(name)]
+    if forcing.name:
+        names = [name for name in names if name == forcing.name]
+    if not names or any("::=" in name for name in names):
+        return None
+    start = _tag_literal(tool_start, single_id)
+    lead, trail = (" WS? ", " WS?") if outer_ws else (" ", "")
+    content = content_max_tokens > 0 and start.startswith("<[")
+    calls = "call" if forcing.single_call else "call (WS? call)*"
+    lines = [f"start:{lead}{'content? ' if content else ''}{calls}{trail}" +
+             (f" |{lead}content" if content else "")]
+    if content:
+        lines.append(f"content[max_tokens={int(content_max_tokens)}]: " + r"/(?s:[^ \t\r\n].*)/")
+    lines.append(f"call: {start} WS? (" + " | ".join(_lark_string(n) for n in names) +
+                 f") WS? (param WS?)* {_tag_literal(tool_end, single_id)}")
+    ak, ake, av, ave = [_tag_literal(t, single_id) for t in
+                        ("<arg_key>", "</arg_key>", "<arg_value>", "</arg_value>")]
+    # A special closing tag terminates a free ordinary-token lexeme; otherwise
+    # include the literal closing tag in a lazy lexeme, as the Qwen builder does.
+    key = "key " + ake if ake.startswith("<[") else "key"
+    value = "value " + ave if ave.startswith("<[") else "value"
+    lines.append(f"param: {ak} {key} WS? {av} {value}")
+    lines.append("key: /[^<>]+/" if ake.startswith("<[") else r"key[lazy]: /[^<>]+<\/arg_key>/")
+    lines.append("value: /(?s:.*)/" if ave.startswith("<[") else r"value[lazy]: /(?s:.*)<\/arg_value>/")
+    lines.append(r"WS: /[ \t\r\n]{1," + str(_MAX_WS) + "}/")
+    return "\n".join(lines) + "\n"
+
