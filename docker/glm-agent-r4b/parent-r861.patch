+"""Opt-in GLM history/choice/typing fixes. See the overlay's THIRD_PARTY.md.
+
+Reasoning memory and union typing are adapted from TensorFold Spark patch 0620
+(Apache-2.0). Memory belongs to the loaded model container, not a global app.
+"""
+
+import hashlib
+import json
+import math
+import os
+from collections import OrderedDict
+
+
+def enabled(tool_format):
+    return tool_format == "glm4_5" and os.getenv("TABBY_GLM_TOOL_FIXES") == "1"
+
+
+def forcing_enabled(tool_format):
+    return enabled(tool_format) and os.getenv("TABBY_GLM_FORCING") == "1"
+
+
+_JSON_TYPES = {str: "string", bool: "boolean", int: "integer", float: "number",
+               list: "array", dict: "object", type(None): "null"}
+
+
+def schema_types(schema):
+    if not isinstance(schema, dict):
+        return None
+    kind = schema.get("type")
+    if isinstance(kind, str):
+        return {kind}
+    if isinstance(kind, list) and kind and all(isinstance(k, str) for k in kind):
+        return set(kind)
+    for key in ("anyOf", "oneOf"):
+        members = schema.get(key)
+        if isinstance(members, list) and members:
+            types = [schema_types(member) for member in members]
+            return None if any(t is None for t in types) else set().union(*types)
+    values = schema.get("enum") or ([schema["const"]] if "const" in schema else None)
+    if isinstance(values, list) and values:
+        return {_JSON_TYPES.get(type(v)) for v in values}
+    return None
+
+
+def typed_value(raw, schema):
+    types = schema_types(schema)
+    if types and "string" in types:
+        return None if "null" in types and raw.strip() == "null" else raw
+    try:
+        value = json.loads(raw)
+        if types and isinstance(value, str):
+            value = json.loads(value)
+        if isinstance(value, float):
+            if not math.isfinite(value):
+                return raw  # JSON disallows NaN and infinity
+            if types and "integer" in types and "number" not in types and value.is_integer():
+                value = int(value)
+        kind = _JSON_TYPES.get(type(value))
+        if types is None or kind in types or (kind == "integer" and "number" in types):
+            return value
+    except (ValueError, TypeError):
+        pass
+    return raw.strip() if types is None else raw
+
+
+def properties(tools, name):
+    for tool in tools or []:
+        fn = tool.get("function", tool)
+        if fn.get("name") == name:
+            return (fn.get("parameters") or {}).get("properties") or {}
+    return {}
+
+
+def active_tools(data):
+    tools = data.model_dump()["tools"] or []
+    if data.tool_choice == "none":
+        return []
+    name = getattr(getattr(data.tool_choice, "function", None), "name", None)
+    return [t for t in tools if t["function"]["name"] == name] if name else tools
+
+
+def call_limit(data):
+    named = getattr(getattr(data.tool_choice, "function", None), "name", None)
+    return 1 if named or data.parallel_tool_calls is False else None
+
+
+def canonical_messages(messages):
+    """Full visible prefix; canonical args and positions allow client-renumbered ids.
+
+    This intentionally ignores reasoning (which clients may omit), but retains
+    system/user messages, earlier calls and results. Identical visible prefixes
+    from separate conversations remain ambiguous without a conversation id.
+    """
+    result = []
+    for message in messages:
+        m = {k: v for k, v in message.items()
+             if k not in ("reasoning", "reasoning_content", "tool_call_id")}
+        m["content"] = m.get("content") or ""
+        if m.get("tool_calls"):
+            calls = []
+            for call in m["tool_calls"]:
+                fn = dict(call["function"])
+                args = fn.get("arguments")
+                if isinstance(args, str):
+                    try:
+                        args = json.loads(args) if args.strip() else {}
+                    except ValueError:
+                        pass
+                fn["arguments"] = args
+                calls.append({"function": fn})
+            m["tool_calls"] = calls
+        result.append(m)
+    return result
+
+
+def history_key(messages):
+    raw = json.dumps(canonical_messages(messages), sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+    return hashlib.sha256(raw.encode("utf-8", "surrogatepass")).hexdigest()
+
+
+class ReasoningMemory:
+    """256 replies / 8 MiB UTF-8 LRU; exact full-prefix matching, per model."""
+
+    def __init__(self, entries=256, byte_limit=8 << 20):
+        self.entries, self.byte_limit = entries, byte_limit
+        self.items = OrderedDict()
+        self.size = 0
+
+    def put(self, key, reasoning):
+        size = len(reasoning.encode("utf-8", "surrogatepass"))
+        if not reasoning or size > self.byte_limit or self.entries <= 0:
+            return
+        old = self.items.pop(key, None)
+        if old:
+            self.size -= old[1]
+        self.items[key] = (reasoning, size)
+        self.size += size
+        while self.size > self.byte_limit or len(self.items) > self.entries:
+            _, (_, removed) = self.items.popitem(last=False)
+            self.size -= removed
+
+    def get(self, key):
+        entry = self.items.get(key)
+        if entry is not None:
+            self.items.move_to_end(key)
+            return entry[0]
+        return None
+
+
+def memory(mc):
+    if not hasattr(mc, "_glm_tool_reasoning"):
+        mc._glm_tool_reasoning = ReasoningMemory()
+    return mc._glm_tool_reasoning
+
+
+def prepare_history(messages, mc):
+    for i, message in enumerate(messages):
+        if message.get("content") is None:
+            message["content"] = ""
+        if message.get("role") != "assistant":
+            continue
+        if not isinstance(message.get("reasoning_content"), str) and isinstance(message.get("reasoning"), str):
+            message["reasoning_content"] = message["reasoning"]
+        for call in message.get("tool_calls") or []:
+            fn = call["function"]
+            if fn.get("arguments") is None or (isinstance(fn.get("arguments"), str) and not fn["arguments"].strip()):
+                fn["arguments"] = {}
+        if (message.get("tool_calls") and not isinstance(message.get("reasoning_content"), str)
+                and "</think>" not in message["content"]):
+            kept = memory(mc).get(history_key(messages[:i + 1]))
+            if kept is not None:
+                message["reasoning_content"] = kept
+        # GLM's template tests only ID presence, then drops unmatched results.
+        # A missing ID selects its lossless in-order fallback for the whole run.
+        ids = {c.get("id") for c in message.get("tool_calls") or []}
+        for result in messages[i + 1:]:
+            if result.get("role") != "tool":
+                break
+            if result.get("tool_call_id") not in ids:
+                result.pop("tool_call_id", None)
+
+
+def remember(mc, data, content, calls, reasoning):
+    if calls and reasoning:
+        history = [m.model_dump(exclude_none=True) for m in data.messages]
+        history.append({"role": "assistant", "content": content or "", "tool_calls": calls})
+        memory(mc).put(history_key(history), reasoning)
+
+
+def thinking_prompt(prompt, data):
+    if data.template_vars.get("enable_thinking") is False and data.add_generation_prompt and prompt.endswith("<think>"):
+        return prompt + "</think>"
+    return prompt
