+"""Append-only GLM deltas. Plain strings stream; JSON candidates wait for closure."""
+
+import json
+import os
+
+from endpoints.OAI.types.tools import ToolCall, Tool
+from endpoints.OAI.utils import glm_tool_fixes as glm_fixes
+from endpoints.OAI.utils.toolcall_formats.common import coerce_param_value
+from endpoints.OAI.utils.toolcall_formats.glm4_5 import parse_toolcalls
+
+
+def stream_toolcalls_enabled(tool_format, streaming_mode):
+    return streaming_mode and tool_format == "glm4_5" and os.getenv("TABBY_STREAM_TOOLCALLS") == "1"
+
+
+class _Fields:
+    """Independent non-nested regex-equivalent tag scanner, with bounded tag holdback."""
+
+    def __init__(self, start, end):
+        self.start, self.end = start, end
+        self.inside = False
+        self.pending = ""
+
+    def feed(self, text):
+        self.pending += text
+        events = []
+        while self.pending:
+            token = self.end if self.inside else self.start
+            pos = self.pending.find(token)
+            if pos >= 0:
+                if self.inside and pos:
+                    events.append(("text", self.pending[:pos]))
+                self.pending = self.pending[pos + len(token):]
+                events.append(("end" if self.inside else "start", ""))
+                self.inside = not self.inside
+                continue
+            hold = 0
+            for size in range(min(len(token) - 1, len(self.pending)), 0, -1):
+                if token.startswith(self.pending[-size:]):
+                    hold = size
+                    break
+            safe = len(self.pending) - hold
+            if self.inside and safe:
+                events.append(("text", self.pending[:safe]))
+            self.pending = self.pending[safe:]
+            break
+        return events
+
+
+class _Value:
+    def __init__(self):
+        self.parts = []
+        self.closed = False
+        self.first = None
+        self.plain = False
+        self.literal = None
+        self.literal_pos = 0
+
+    def add(self, text):
+        self.parts.append(text)
+        if self.first is None:
+            text = text.lstrip()
+            if not text:
+                return
+            self.first = text[0]
+            # Include Python json.loads' NaN/Infinity extensions. No schema
+            # overrides this: the served parser always attempts json.loads.
+            self.plain = self.first not in '{["-0123456789tfnNI'
+            self.literal = {
+                "t": "true", "f": "false", "n": "null", "N": "NaN", "I": "Infinity"
+            }.get(self.first)
+        if self.literal and not self.plain:
+            for char in text:
+                if self.literal_pos < len(self.literal):
+                    if char != self.literal[self.literal_pos]:
+                        self.plain = True
+                        break
+                    self.literal_pos += 1
+                elif not char.isspace():
+                    self.plain = True
+                    break
+
+
+class _Block:
+    def __init__(self, owner):
+        self.owner = owner
+        self.parts = []
+        self.name_pending = ""
+        self.name = None
+        self.call = None
+        self.keys = []
+        self.key_parts = []
+        self.key_scan = _Fields("<arg_key>", "</arg_key>")
+        self.value_scan = _Fields("<arg_value>", "</arg_value>")
+        self.values = []
+        self.emitted = 0
+        self.active = False
+        self.leading = True
+        self.whitespace = ""
+        self.arguments_started = False
+        self.emitted_args = {}
+        self.duplicate = False
+
+    def _header(self, name):
+        self.name = name.strip()
+        if not self.name:
+            return
+        if self.owner.fixes_on:
+            names = {t.get("function", t).get("name") for t in self.owner.tools}
+            if self.name not in names or (self.owner.max_calls is not None and self.owner.next_index >= self.owner.max_calls):
+                return
+        self.call = ToolCall(function=Tool(name=self.name, arguments=""))
+        self.call.index = self.owner.next_index
+        self.owner.next_index += 1
+        self.owner.deltas.append({
+            "index": self.call.index, "id": self.call.id, "type": "function",
+            "function": {"name": self.name, "arguments": ""},
+        })
+
+    def _delta(self, text):
+        if text:
+            self.owner.deltas.append({"index": self.call.index, "function": {"arguments": text}})
+
+    def _member(self, key):
+        prefix = ", " if self.arguments_started else "{"
+        self.arguments_started = True
+        return prefix + json.dumps(key, ensure_ascii=False) + ": "
+
+    def _string_text(self, text):
+        if self.owner.fixes_on:
+            self._delta(json.dumps(text, ensure_ascii=False)[1:-1])
+            return
+        if self.leading:
+            text = text.lstrip()
+            if not text:
+                return
+            self.leading = False
+        text = self.whitespace + text
+        stripped = text.rstrip()
+        self.whitespace = text[len(stripped):]
+        self._delta(json.dumps(stripped, ensure_ascii=False)[1:-1])
+
+    def _coerce(self, key, raw):
+        if self.owner.fixes_on:
+            return glm_fixes.typed_value(raw, glm_fixes.properties(self.owner.tools, self.name).get(key))
+        return coerce_param_value(raw)
+
+    def _advance(self):
+        if not self.call or self.duplicate:
+            return
+        while self.emitted < len(self.values) and self.emitted < len(self.keys):
+            value = self.values[self.emitted]
+            key = self.keys[self.emitted]
+            if self.active:
+                if not value.closed:
+                    return
+                self._delta('"')
+                self.active = False
+                self.emitted_args[key] = self._coerce(key, "".join(value.parts))
+                self.emitted += 1
+            elif value.closed:
+                coerced = self._coerce(key, "".join(value.parts))
+                self._delta(self._member(key) + json.dumps(coerced, ensure_ascii=False))
+                self.emitted_args[key] = coerced
+                self.emitted += 1
+            elif value.plain and (not self.owner.fixes_on or "string" in
+                    (glm_fixes.schema_types(glm_fixes.properties(self.owner.tools, self.name).get(key)) or set())):
+                self._delta(self._member(key) + '"')
+                self.active = True
+                self.leading = True
+                self.whitespace = ""
+                self._string_text("".join(value.parts))
+                return
+            else:
+                return
+
+    def feed(self, text):
+        self.parts.append(text)
+        if self.name is None:
+            self.name_pending += text
+            pos = self.name_pending.find("<arg_key>")
+            if pos >= 0:
+                self._header(self.name_pending[:pos])
+                self.name_pending = ""
+        for event, sub in self.key_scan.feed(text):
+            if event == "start":
+                self.key_parts = []
+            elif event == "text":
+                self.key_parts.append(sub)
+            else:
+                key = "".join(self.key_parts).strip()
+                if key in self.keys:
+                    self.duplicate = True
+                    self.owner.invalid = True
+                self.keys.append(key)
+        for event, sub in self.value_scan.feed(text):
+            if event == "start":
+                self.values.append(_Value())
+            elif event == "text":
+                self.values[-1].add(sub)
+                if self.active and self.emitted == len(self.values) - 1:
+                    self._string_text(sub)
+            else:
+                self.values[-1].closed = True
+            self._advance()
+
+    def finish(self):
+        # A truncated value can end in a proper prefix of its closing tag.
+        # Flush that literal text, but never fabricate a value/call terminator.
+        if self.value_scan.inside and self.value_scan.pending:
+            text = self.value_scan.pending
+            self.value_scan.pending = ""
+            self.values[-1].add(text)
+            if self.active and self.emitted == len(self.values) - 1:
+                self._string_text(text)
+            self._advance()
+
+    def close(self):
+        raw = "<tool_call>" + "".join(self.parts) + "</tool_call>"
+        if self.duplicate or self.key_scan.inside or self.value_scan.inside:
+            self.owner.invalid = True
+            return
+        try:
+            parsed = (parse_toolcalls(raw, self.owner.tools) if self.owner.fixes_on
+                      else parse_toolcalls(raw))
+        except Exception:
+            # Missing values make the served parser fail the whole parse. An
+            # already sent header/body is necessarily an incomplete call.
+            self.owner.invalid = True
+            return
+        if not parsed:
+            # A filtered name or excess call was never announced. Malformed
+            # accepted calls must invalidate the turn, including zero-arg bodies.
+            if self.call is not None or (not self.owner.fixes_on and "".join(self.parts).strip()):
+                self.owner.invalid = True
+            return
+        canonical = parsed[0]
+        if self.name is None:
+            self._header(canonical.function.name)
+        if not self.call:
+            return
+        self._advance()
+        if not self.arguments_started:
+            self._delta(canonical.function.arguments)
+        else:
+            # The legacy dict has distinct Python keys None and "null".
+            # JSON serializes both as "null"; decoding canonical JSON here
+            # would collapse them. Extra values map to None (last wins).
+            if len(self.values) > len(self.keys):
+                value = self._coerce(None, "".join(self.values[-1].parts))
+                self._delta(self._member("null") + json.dumps(value, ensure_ascii=False))
+            self._delta("}")
+        self.call.function.arguments = canonical.function.arguments
+        self.owner.calls.append(self.call.model_dump(mode="json"))
+
+
+class GLMToolCallStream:
+    """Consumes TOOL-channel text from TagStreamParser; indices are per choice."""
+
+    def __init__(self, tools=None, max_calls=None):
+        self.tools, self.max_calls = tools, max_calls
+        self.fixes_on = glm_fixes.enabled("glm4_5") and tools is not None
+        self.outer = _Fields("<tool_call>", "</tool_call>")
+        self.block = None
+        self.next_index = 0
+        self.calls = []
+        self.invalid = False
+        self.deltas = []
+
+    @property
+    def unfinished(self):
+        return self.block is not None or bool(self.outer.pending)
+
+    def feed(self, text, final=False):
+        self.deltas = []
+        for event, sub in self.outer.feed(text):
+            if event == "start":
+                self.block = _Block(self)
+            elif event == "text":
+                self.block.feed(sub)
+            else:
+                self.block.close()
+                self.block = None
+        if final and self.block is not None:
+            if self.outer.pending:
+                self.block.feed(self.outer.pending)
+                self.outer.pending = ""
+            self.block.finish()
+        # A backend chunk can span several parser events. Emit at most one
+        # entry per index in a frame, as OpenAI clients expect.
+        merged = {}
+        for delta in self.deltas:
+            index = delta["index"]
+            if index not in merged:
+                merged[index] = delta
+            else:
+                merged[index]["function"]["arguments"] += delta["function"]["arguments"]
+        return list(merged.values())
