+"""Idle SSE comments, serialized through the same sender as data frames."""
+
+import asyncio
+import math
+import os
+import sys
+from contextlib import nullcontext
+from time import monotonic
+
+
+def keepalive_seconds():
+    raw = os.getenv("TABBY_SSE_KEEPALIVE_S", "")
+    if not raw or raw == "0":
+        return None
+    try:
+        seconds = float(raw)
+    except ValueError as exc:
+        raise ValueError("TABBY_SSE_KEEPALIVE_S must be finite and positive (or 0/off)") from exc
+    if not math.isfinite(seconds) or seconds <= 0:
+        raise ValueError("TABBY_SSE_KEEPALIVE_S must be finite and positive (or 0/off)")
+    return seconds
+
+
+async def idle_comments(
+    source, seconds, disconnect_handler, *, clock=monotonic, wait=asyncio.wait,
+    cleanup_scope=nullcontext,
+):
+    """Never cancel an anext on timeout: that would abort model generation."""
+    iterator = source.__aiter__()
+    pending = None
+    disconnected = asyncio.create_task(disconnect_handler.abort_event.wait())
+    last_write = clock()
+    try:
+        while not disconnect_handler.disconnected:
+            if pending is None:
+                pending = asyncio.ensure_future(iterator.__anext__())
+            done, _ = await wait(
+                {pending, disconnected},
+                timeout=max(0.0, seconds - (clock() - last_write)),
+                return_when=asyncio.FIRST_COMPLETED,
+            )
+            if disconnected in done or disconnect_handler.disconnected:
+                return
+            if pending in done:
+                try:
+                    frame = pending.result()
+                except StopAsyncIteration:
+                    return
+                pending = None
+                yield frame
+                last_write = clock()  # resumed only after the frame's ASGI send
+                if frame == "[DONE]":
+                    return
+            else:
+                # bytes bypass EventSourceResponse's data-field encoding.
+                yield b": keepalive\n\n"
+                last_write = clock()
+    finally:
+        # EventSourceResponse uses AnyIO cancellation scopes. Shield cleanup
+        # from their repeated cancellation at each await after a disconnect.
+        with cleanup_scope():
+            tasks = [task for task in (pending, disconnected) if task is not None]
+            for task in tasks:
+                task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+            try:
+                await iterator.aclose()
+            finally:
+                await disconnect_handler.cleanup()
+
+
+def keepalive_response(source, disconnect_handler, ping):
+    from sse_starlette import EventSourceResponse
+
+    seconds = keepalive_seconds()
+    if seconds is None:
+        # Preserve the original response and its configured pings byte for byte.
+        return EventSourceResponse(source, ping=ping)
+    # Disable the independent periodic pinger. All comments/data use one
+    # async iterator, so neither can interleave or race with [DONE].
+    from anyio import CancelScope  # already required by sse-starlette
+
+    class ClosingEventSourceResponse(EventSourceResponse):
+        async def __call__(self, scope, receive, send):
+            try:
+                await super().__call__(scope, receive, send)
+            finally:
+                # The superclass has joined its sending/listening tasks now.
+                # A disconnect during send leaves the iterator at yield, so
+                # its own finally cannot run until the response closes it.
+                with CancelScope(shield=True):
+                    try:
+                        await self.body_iterator.aclose()
+                    finally:
+                        await disconnect_handler.cleanup()
+
+    return ClosingEventSourceResponse(
+        idle_comments(
+            source, seconds, disconnect_handler,
+            cleanup_scope=lambda: CancelScope(shield=True),
+        ),
+        ping=sys.maxsize,
+    )
