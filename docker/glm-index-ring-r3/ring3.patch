diff -ruN base/exllamav3/cache/mla_index_ring.py src/exllamav3/cache/mla_index_ring.py
--- base/exllamav3/cache/mla_index_ring.py	1970-01-01 01:00:00
+++ src/exllamav3/cache/mla_index_ring.py	2026-10-08 14:00:48
@@ -0,0 +1,113 @@
+"""Lossless residue of the GLM pooled indexer; never a paged cache tensor."""
+import os
+import torch
+from ..constants import PAGE_SIZE
+
+INDEX_RING = os.environ.get("EXL3_DSA_INDEX_RING", "0") == "1"
+INDEX_RING_SHADOW = os.environ.get("EXL3_DSA_INDEX_RING_SHADOW", "0") == "1"
+if INDEX_RING_SHADOW and not INDEX_RING:
+    raise ValueError("EXL3_DSA_INDEX_RING_SHADOW requires EXL3_DSA_INDEX_RING=1")
+
+
+def ring_slots(params, batch_size):
+    slots = params.get("_index_ring_slots")
+    if slots is None:
+        states = params.get("recurrent_states")
+        if states is None or len(states) != batch_size:
+            raise ValueError("Index ring requires one target job slot per sequence")
+        slots = tuple(r.slot for r in states)
+    if len(slots) != batch_size or len(set(slots)) != batch_size:
+        raise ValueError("Index ring requires distinct target job slots")
+    return tuple(slots)
+
+
+class MLAIndexRingState:
+    is_index_ring = True
+    def __init__(self, module, max_batch_size, max_history, cache_id,
+                 max_chunk_size=2048):
+        self.module = module
+        self.cache_id = cache_id
+        self.max_batch_size = max_batch_size
+        self.max_history = max_history
+        self.peers = ()  # MTP ring tails follow the target job's checkpoint/slot lifecycle.
+        self.device = None
+        self.configure(max_chunk_size)
+
+    def configure(self, max_chunk_size):
+        if self.device is not None:
+            raise RuntimeError("Configure index rings before model load")
+        self.max_chunk_size = max(max_chunk_size, self.max_history + 1)
+        # Retain the incoming window, its pre-existing tail, and speculative rollback.
+        P = self.module.index_kpool
+        assert P > 0 and PAGE_SIZE % P == 0
+        n = self.max_chunk_size + self.max_history + P - 1
+        self.rows = -(-n // PAGE_SIZE) * PAGE_SIZE
+        self.ring = torch.zeros((self.max_batch_size, self.rows,
+                                 self.module.idx_plane_dim), dtype=torch.half, device="meta")
+
+    def storage_size(self):
+        return self.ring.numel() * self.ring.element_size()
+
+    def get_checkpoint_size(self):
+        return ((self.module.index_kpool - 1) * self.module.idx_plane_dim * 2 +
+                sum(p.get_checkpoint_size() for p in self.peers))
+
+    def checkpoint_parts(self):
+        return 1 + sum(p.checkpoint_parts() for p in self.peers)
+
+    def alloc(self, device):
+        self.device = device
+        self.ring = torch.zeros_like(self.ring, device=device)
+
+    def free(self):
+        self.device = None
+        self.ring = torch.zeros_like(self.ring, device="meta")
+
+    def clear(self, slot):
+        self.ring[slot].zero_()
+        for peer in self.peers:
+            peer.clear(slot)
+
+    def rewind(self, slot, last_history, num_tokens):
+        # Positions determine addressing. A recorded verify window and its initial
+        # incomplete pool remain in the ring after a supported speculative rewind.
+        if not 0 <= num_tokens <= min(last_history, self.max_history):
+            raise ValueError("Index ring rewind requires a checkpoint and replay")
+        if INDEX_RING_SHADOW:
+            from .mla_index_shadow import STATS
+            STATS.event("rewind" if num_tokens else "accept")
+
+    def stash(self, slot, position=0):
+        n = position % self.module.index_kpool
+        ids = torch.arange(position - n, position, device=self.ring.device) % self.rows
+        if INDEX_RING_SHADOW:
+            from .mla_index_shadow import STATS
+            STATS.event("checkpoint_stash")
+        # Disk checkpoint serialization expects a flat tuple of CPU tensors.
+        return (self.ring[slot, ids].cpu().clone(),) + tuple(
+            t for p in self.peers for t in p.stash(slot, position))
+
+    def unstash(self, slot, stashed, position=0):
+        if len(stashed) != self.checkpoint_parts():
+            raise ValueError("Invalid pooled-indexer checkpoint peers")
+        tail = stashed[0]
+        n = position % self.module.index_kpool
+        if tail.shape != (n, self.module.idx_plane_dim) or tail.dtype != torch.half:
+            raise ValueError("Invalid pooled-indexer checkpoint tail")
+        self.clear(slot)
+        ids = torch.arange(position - n, position, device=self.ring.device) % self.rows
+        self.ring[slot, ids] = tail.to(self.ring.device)
+        offset = 1
+        for peer in self.peers:
+            end = offset + peer.checkpoint_parts()
+            peer.unstash(slot, stashed[offset:end], position)
+            offset = end
+        if INDEX_RING_SHADOW:
+            from .mla_index_shadow import STATS
+            STATS.event("checkpoint_restore")
+
+    def tp_export(self, plan):
+        return {"cls": MLAIndexRingState, "args": {
+            "cache_id": self.cache_id, "max_batch_size": self.max_batch_size,
+            "max_history": self.max_history, "max_chunk_size": self.max_chunk_size,
+        }}
diff -ruN base/exllamav3/cache/mla_index_shadow.py src/exllamav3/cache/mla_index_shadow.py
--- base/exllamav3/cache/mla_index_shadow.py	1970-01-01 01:00:00
+++ src/exllamav3/cache/mla_index_shadow.py	2026-10-08 16:04:23
@@ -0,0 +1,221 @@
+"""In-invocation oracle for pooled DSA. Never writes served tensors or shared scratch."""
+import atexit
+from collections import Counter
+import json
+import time
+import torch
+from .mla_index_ring import INDEX_RING_SHADOW
+from ..constants import PAGE_SIZE
+
+
+class ShadowStats:
+    def __init__(self):
+        self.active = False  # Loader/autosplit probes do not count as served coverage.
+        self.calls = self.compared_rows = self.mismatches = 0  # mismatches counts bytes.
+        self.coverage = Counter()
+        self.layers = Counter()
+        self.kinds = Counter()
+        self.last_summary = time.monotonic()
+
+    def event(self, name, n=1):
+        if self.active:
+            self.coverage[name] += n
+
+    def summary(self, reason):
+        if INDEX_RING_SHADOW and self.active:
+            print(f"[RING-SHADOW] calls={self.calls} compared_rows={self.compared_rows} "
+                  f"mismatches={self.mismatches} layers={len(self.layers)} "
+                  f"coverage={json.dumps(dict(self.coverage), separators=(',', ':'))} "
+                  f"kinds={json.dumps(dict(self.kinds), separators=(',', ':'))} "
+                  f"layer_calls={json.dumps(dict(self.layers), separators=(',', ':'))} "
+                  f"reason={reason} mismatch_unit=bytes compared_row_unit=tensor_rows", flush=True)
+            self.last_summary = time.monotonic()
+
+
+STATS = ShadowStats()
+atexit.register(STATS.summary, "shutdown")
+
+
+class RingShadow:
+    # Implements the pool builder's cache-layer interface for the independent paged oracle.
+    index_ring = None
+
+    def __init__(self, layer):
+        self.layer = layer
+        self.pool = torch.zeros_like(layer.k_pool)
+        self.context = {}
+
+    def get_idx(self):
+        return self.layer.k_idx
+
+    def update_pool_direct(self, seq, table, keys):
+        from ..modules.attention_fn.mla_triton import mla_plane_append
+        mla_plane_append(keys, self.pool, table, seq)
+
+    def begin(self, module, table, starts, length, slots, backend, params):
+        self.context = dict(layer=module.key, layer_idx=module.layer_idx,
+                            slots=list(slots), positions=list(starts), length=length,
+                            backend=backend, pool_size=module.index_kpool)
+        if not STATS.active:
+            return
+        STATS.calls += 1
+        STATS.layers[module.key] += 1
+        STATS.event(backend)
+        STATS.event(f"c{len(slots)}")
+        STATS.event("prefill" if length > 2 else "decode")
+        if params.get("recurrent_history") and length == 2:
+            STATS.event("verify2")
+        if ".layers.45." in module.key:
+            STATS.event("mtp_draft")
+        if len(set(starts)) > 1:
+            STATS.event("ragged")
+        if params.get("indexed_embeddings"):
+            STATS.event("vision")
+        self.members(module, table, starts, length, slots)
+        if STATS.calls % 100 == 0 or time.monotonic() - STATS.last_summary >= 30:
+            STATS.summary("periodic")
+
+    def compare(self, kind, served, oracle, detail=None, row_context=None):
+        if not STATS.active:
+            return
+        if served.shape != oracle.shape or served.dtype != oracle.dtype:
+            raise RuntimeError(f"RING-SHADOW invalid comparison {kind}: {served.shape}/{oracle.shape}")
+        # Compare bytes, including signed zero / NaN payloads. All reductions use private results.
+        a = served.detach().contiguous().view(torch.uint8)
+        b = oracle.detach().contiguous().view(torch.uint8)
+        different = a != b
+        count = int(torch.count_nonzero(different).item())
+        rows = served.shape[0] if served.ndim else 1
+        STATS.compared_rows += rows
+        STATS.kinds[kind] += rows
+        if count:
+            STATS.mismatches += count
+            if STATS.coverage["mismatch_logs"] < 8:
+                byte_index = int(different.reshape(-1).int().argmax().item())
+                element_index = byte_index // served.element_size()
+                coords, remainder = [], element_index
+                for size in reversed(served.shape):
+                    coords.insert(0, remainder % size)
+                    remainder //= size
+                row = coords[0] if coords else 0
+                batch = (detail or {}).get("batch", 0)
+                slots, starts = self.context.get("slots", []), self.context.get("positions", [])
+                query_row = row
+                if kind in ("pool_topk", "topk") and detail is None and starts and rows % len(starts) == 0:
+                    batch, query_row = divmod(row, rows // len(starts))
+                first = dict(layer=self.context.get("layer"), layer_idx=self.context.get("layer_idx"),
+                             slot=slots[batch] if batch < len(slots) else None,
+                             batch=batch, row_index=row, index=coords, element_index=element_index,
+                             byte_index=byte_index, byte_in_element=byte_index % served.element_size(),
+                             served_byte=int(a.reshape(-1)[byte_index].item()),
+                             oracle_byte=int(b.reshape(-1)[byte_index].item()),
+                             dtype=str(served.dtype), served=served[tuple(coords)].item(),
+                             oracle=oracle[tuple(coords)].item())
+                if kind in ("scores", "pool_topk", "topk") and batch < len(starts):
+                    first["query_row"] = (detail or {}).get("row", 0) + query_row
+                    first["position"] = starts[batch] + first["query_row"]
+                    if kind == "scores" and len(coords) > 1:
+                        first["pool_index"] = (detail or {}).get("tile", 0) + coords[1]
+                        first["pool_position"] = first["pool_index"] * self.context["pool_size"]
+                if row_context is not None:
