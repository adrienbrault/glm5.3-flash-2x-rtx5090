+            table.shape[1], length, page_size=PAGE_SIZE, P=P, D=D,
+            MAXPOOLS=length // P + 1, RING_ROWS=0, num_warps=2, num_stages=1)
+        self.begin(module, table, starts, length, slots, backend, params)
