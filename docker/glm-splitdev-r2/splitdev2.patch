diff -ruN base/exllamav3/model/moe_split_check.py src/exllamav3/model/moe_split_check.py
--- base/exllamav3/model/moe_split_check.py	1970-01-01 01:00:00
+++ src/exllamav3/model/moe_split_check.py	2026-10-08 14:16:36
@@ -0,0 +1,71 @@
+"""Opt-in synchronous CPU split diagnostics; no Torch/native imports when disabled.
+
+CHECK is for the warmup/probe boot. It validates every checked forward while enabled,
+including new batch shapes and post-exchange maps; reboot with CHECK=0 for timing.
+"""
+import os
+
+ENABLED = os.environ.get("EXL3_MOE_CPU_SPLIT_CHECK", "0") == "1"
+
+
+def fail(layer, tensor, detail):
+    raise RuntimeError(f"[SPLIT-CHECK] layer={layer} tensor={tensor}: {detail}")
+
+
+def values(tensor):
+    if hasattr(tensor, "detach"):
+        # Debug only: read back before the potentially fatal indexing operation.
+        return tensor.detach().cpu().reshape(-1).tolist()
+    return list(tensor)
+
+
+def index_range(layer, name, tensor, lower, upper):
+    vals = values(tensor)
+    if vals and (min(vals) < lower or max(vals) >= upper):
+        fail(layer, name, f"range=[{min(vals)},{max(vals)}] expected=[{lower},{upper})")
+
+
+def layer_name(host, idx):
+    return next((key for key, i in host.by_key.items() if i == idx), f"worker_idx={idx}")
+
+
+def host_selection(host, idx, name, selection):
+    layer = layer_name(host, idx)
+    if not 0 <= idx < len(host.specs):
+        fail(layer, "cpu_layer_idx", f"{idx} outside {len(host.specs)} registrations")
+    index_range(layer, name, selection, -1, host.specs[idx]["num_experts"])
+
+
+def module_layout(module):
+    layer = module.key
+    first, experts = module.cpu_split_first, module.num_experts
+    host, idx = module.cpu_host, module.cpu_layer_idx
+    if not 0 < first < experts or module.num_local_experts != first:
+        fail(layer, "cpu_split_first/num_local_experts", f"first={first} gpu={module.num_local_experts} E={experts}")
+    if not 0 <= idx < len(host.specs):
+        fail(layer, "cpu_layer_idx", f"{idx} outside {len(host.specs)} registrations")
+    count = experts - first
+    spec = host.specs[idx]
+    if spec["num_experts"] != count:
+        fail(layer, "spec.num_experts", f"worker={spec['num_experts']} module={count} first={first} idx={idx}")
+    for name in ("up_keys", "down_keys") + (("gate_keys",) if module.gated else ()):
+        if len(spec[name]) != count:
+            fail(layer, name, f"len={len(spec[name])} expected={count}")
+    for name, tensors in host.aux.get(idx, {}).items():
+        if tensors is not None and len(tensors) != count:
+            fail(layer, f"aux.{name}", f"len={len(tensors)} expected={count}")
+    for name in ("layer_blocks", "exchange_views"):
+        entries = getattr(host, name, ())
+        if idx < len(entries) and entries[idx] is not None and len(entries[idx]) != count:
+            fail(layer, name, f"len={len(entries[idx])} expected={count} idx={idx}")
+    mp = getattr(module, "_split_map", None)
+    if mp is not None and sorted(values(mp)) != list(range(experts)):
+        fail(layer, "_split_map", f"expected permutation of [0,{experts})")
+
+
+def exchange_slots(module, mp, cold, hot):
+    module_layout(module)
+    index_range(module.key, "exchange.router_ids", [cold, hot], 0, module.num_experts)
+    slot, local = int(mp[cold]), int(mp[hot]) - module.cpu_split_first
+    index_range(module.key, "exchange.gpu_slot", [slot], 0, module.cpu_split_first)
+    index_range(module.key, "exchange.cpu_local", [local], 0, module.num_experts - module.cpu_split_first)
