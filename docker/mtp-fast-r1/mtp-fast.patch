 # Kernel-fused issue/collect for decode-size split jobs (EXL3_MOE_SPLIT_FUSED=0 restores the
 # cudaMemcpyAsync path for A/B testing)
 _split_fused = os.environ.get("EXL3_MOE_SPLIT_FUSED", "1") != "0"
+
+# EXL3_MTP_FAST=1 (default off): a split layer of another component (the MTP head, which shares
+# the main model's config) joins an existing, not yet started CPU worker of the same checkpoint
+# instead of spawning a second worker process. Two workers pin their thread pools to the same
+# physical-core-first CPU list, and every forward primes every host in the config, so each pool
+# spins on the cores the other one is computing on. One worker serves both components; the
+# expert kernels, thread count and work partition are unchanged, so outputs are bitwise equal.
+_mtp_fast = os.environ.get("EXL3_MTP_FAST", "0") == "1"
+
+
+def _join_host(hosts: dict, model_dir, threads: int, hi: int, ho: int, topk: int):
+    """EXL3_MTP_FAST: an existing unstarted host this layer can share, else None (the caller
+    then creates its own host exactly as before). Started hosts cannot take new layers, and
+    the worker requires uniform expert dims and top-k across its layers."""
+    for comp, host in hosts.items():
+        if host.started or host.model_dir != model_dir or host.threads != threads:
+            continue
+        if any(s["hi"] != hi or s["ho"] != ho or s["topk"] != topk for s in host.specs):
+            continue
+        return comp, host
+    return None, None
 
