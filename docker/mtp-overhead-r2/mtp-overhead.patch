@@ -0,0 +1,144 @@
+"""Opt-in stream/host timings. No eager CUDA initialization, no per-phase sync."""
+from __future__ import annotations
+import json
+import os
+import time
+from collections import defaultdict, deque
+from contextlib import contextmanager
+import torch
+
+ENABLED = os.environ.get("EXL3_MTP_PHASE_PROF", "0") == "1"
+TRACE = os.environ.get("EXL3_MTP_PHASE_TRACE", "0") == "1" and ENABLED
+INTERVAL = max(1, int(os.environ.get("EXL3_MTP_PHASE_STEPS", "64"))) if ENABLED else 64
+_active = None
+
+
+def active():
+    return _active
+
+
+class PhaseProfiler:
+    def __init__(self, devices):
+        self.devices = tuple(torch.device(f"cuda:{d}" if isinstance(d, int) else d) for d in devices)
+        self.devices = tuple(d for d in self.devices if d.type == "cuda")
+        self.pending = deque()
+        self.buckets = {}
+        self.records = None
+        self.label = "step"
+
+    def begin(self, mode, batch, depth):
+        global _active
+        self.drain()
+        self.label = "draft" if mode == "mtp" else "plain"
+        self.key = (mode, batch, depth)
+        self.records = []
+        _active = self
+        self.total = self.start("step", self.devices)
+
+    def start(self, name, devices=()):
+        host = time.perf_counter_ns()
+        pairs = []
+        for d in devices:
+            stream = d if hasattr(d, "cuda_stream") else None
+            d = torch.device(stream.device if stream is not None else d)
+            if d.type != "cuda":
+                continue
+            stream = stream if stream is not None else torch.cuda.current_stream(d)
+            a = torch.cuda.Event(enable_timing=True)
+            b = torch.cuda.Event(enable_timing=True)
+            a.record(stream)
+            pairs.append((str(stream.device), stream, a, b))
+        annotation = torch.profiler.record_function("MTP/"+name) if TRACE else None
+        if annotation is not None:
+            annotation.__enter__()
+        return name, host, pairs, annotation
+
+    def stop(self, token):
+        name, host, pairs, annotation = token
+        for _, stream, _, b in pairs:
+            b.record(stream)
+        if annotation is not None:
+            annotation.__exit__(None, None, None)
+        self.records.append((name, (time.perf_counter_ns()-host)/1e6, pairs))
+
+    @contextmanager
+    def span(self, name, devices=()):
+        token = self.start(name, devices)
+        try:
+            yield
+        finally:
+            self.stop(token)
+
+    def end(self):
+        global _active
+        self.stop(self.total)
+        self.pending.append((self.key, self.records))
+        self.records = None
+        _active = None
+        self.drain()
+
+    def drain(self, force=False):
+        # Never synchronize in ordinary steps. Queue-tail flush is profiling-only.
+        while self.pending:
+            key, records = self.pending[0]
+            if force:
+                for _, _, pairs in records:
+                    for _, _, _, b in pairs:
+                        b.synchronize()
+            elif not all(b.query() for _, _, pairs in records for _, _, _, b in pairs):
+                break
+            self.pending.popleft()
+            bucket = self.buckets.setdefault(key, [0, defaultdict(lambda: [0.0, 0]), defaultdict(lambda: [0.0, 0])])
+            bucket[0] += 1
+            for name, host_ms, pairs in records:
+                dst = bucket[1][name]; dst[0] += host_ms; dst[1] += 1
+                for device, _, a, b in pairs:
+                    dst = bucket[2][name+"@"+device]; dst[0] += a.elapsed_time(b); dst[1] += 1
+            if bucket[0] >= INTERVAL:
+                self.emit(key)
+        if force:
+            for key in list(self.buckets):
+                if self.buckets[key][0]:
+                    self.emit(key)
+
+    def emit(self, key):
+        n, host, cuda = self.buckets.pop(key)
+        def totals(items):
+            return {k: {"ms_per_step": round(v[0]/n, 6), "calls": v[1]} for k,v in sorted(items.items())}
+        print("[MTP-PHASE] "+json.dumps({"schema": 1, "mode": key[0], "batch": key[1], "depth": key[2],
+              "steps": n, "host": totals(host), "cuda": totals(cuda)}, sort_keys=True), flush=True)
+
+
+def step_guard(fn):
+    if not ENABLED:
+        return fn
+    from functools import wraps
+    @wraps(fn)
+    def wrapped(*args, **kwargs):
+        global _active
+        try:
+            return fn(*args, **kwargs)
+        except BaseException:
+            if _active is not None:
+                _active.records = None
+                _active = None
+            raise
+    return wrapped
+
+
+def instrument(name, devices=None):
+    # Disabled decoration returns the original function: literally no wrapper overhead.
+    def decorate(fn):
+        if not ENABLED:
+            return fn
+        from functools import wraps
+        @wraps(fn)
+        def wrapped(*args, **kwargs):
+            p = _active
+            if p is None:
+                return fn(*args, **kwargs)
+            ds = devices(*args, **kwargs) if devices else p.devices
+            with p.span(p.label+"."+name, ds):
+                return fn(*args, **kwargs)
+        return wrapped
+    return decorate
