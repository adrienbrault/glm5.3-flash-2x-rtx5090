ARG BASE
FROM ${BASE}
COPY textclock/modules/block_sparse_mlp_cpu.py /tmp/r968-textclock/modules/block_sparse_mlp_cpu.py
COPY textclock/model/moe_exchange.py /tmp/r968-textclock/model/moe_exchange.py
RUN EXL3_MOE_CPU_SWAP_TEXT_CLOCK=1 EXL3_MOE_CPU_SWAP_MODE=exchange EXL3_MOE_CPU_SWAP_POLICY=histogram EXL3_MOE_CPU_SWAP_CADENCE=exact python3 -c "import importlib.util, hashlib, shutil; from pathlib import Path; spec=importlib.util.find_spec('exllamav3'); assert spec and spec.submodule_search_locations, 'exllamav3 package missing'; root=Path(next(iter(spec.submodule_search_locations))); base={'modules/block_sparse_mlp_cpu.py': '32c87143945409784c51b0967b9df34945153137b4e721c2a8e0980203374ee4', 'model/moe_exchange.py': 'a882318f7e82423dd8573c8689dafb2041b5958b710f9b36a2cd7b10fb656f20'}; patched={'modules/block_sparse_mlp_cpu.py': '1a8d2b264b757b5c67490beab38ce2be088011881a0fdb8a7fb24e0bcb47dc5b', 'model/moe_exchange.py': '8ffb7ebc73f31f950d9f4f644acdfa72002ff526d017ae05d84620981533beef'}; assert all(hashlib.sha256((root/f).read_bytes()).hexdigest()==h for f,h in base.items()), 'daily source differs from reviewed src/exllamav3'; [shutil.copyfile(Path('/tmp/r968-textclock')/f, root/f) for f in base]; assert all(hashlib.sha256((root/f).read_bytes()).hexdigest()==h for f,h in patched.items()); import exllamav3.modules.block_sparse_mlp_cpu as cpu; import exllamav3.model.moe_exchange as exchange; assert cpu.TEXT_CLOCK_PATCH_VERSION == exchange.TEXT_CLOCK_PATCH_VERSION == 1; assert cpu._text_clock_enabled; assert Path(cpu.__file__).resolve() == (root/'modules/block_sparse_mlp_cpu.py').resolve(); assert Path(exchange.__file__).resolve() == (root/'model/moe_exchange.py').resolve(); shutil.rmtree('/tmp/r968-textclock')"
